# Copy this file to .env and adjust. .env is git-ignored.

# Where raw / bronze / silver / gold data lives (relative to the project root)
DATA_DIR=./data

# Source of the daily CSV snapshots
SOURCE_BASE_URL=https://rewe.nicoo.org/

# Pause between downloads, in seconds. Be polite to the source server.
DOWNLOAD_SLEEP_SECONDS=1.5

# Identify the project in requests; put a way to reach you here.
USER_AGENT=rewe-ai-portfolio-project (contact: your-email@example.com)
