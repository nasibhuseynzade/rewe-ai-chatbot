# Copy this file to .env and adjust. .env is git-ignored.

# Where raw / bronze / silver / gold data lives (relative to the project root)
DATA_DIR=./data

# Source of the daily CSV snapshots
SOURCE_BASE_URL=https://rewe.nicoo.org/

# Pause between downloads, in seconds. Be polite to the source server.
DOWNLOAD_SLEEP_SECONDS=1.5

# Identify the project in requests; put a way to reach you here.
USER_AGENT=rewe-ai-portfolio-project (contact: your-email@example.com)

# --- Chatbot ---------------------------------------------------------------
# Database the chatbot reads (built by: uv run python -m app.build_serving)
SERVING_PATH=./data/serving.duckdb

# Limits for every query the assistant runs
QUERY_MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=10

# --- LLM providers -----------------------------------------------------------
# Never commit real keys: .env is git-ignored. Test with: uv run python -m app.llm_ping
# Leave a key empty to skip that provider. *_MODEL lines are optional overrides.

# Fallback order: on rate limits or outages the next provider answers.
# Local development: gemini,groq,cloudflare   Production: cloudflare,groq,gemini
LLM_PROVIDERS=gemini,groq,cloudflare

# Google AI Studio. Free tier: local development only (not for EU-facing apps).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cloudflare dashboard -> Workers AI -> Use REST API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it

# Local models (optional): ollama pull qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:4b
